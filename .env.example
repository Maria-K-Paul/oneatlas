# Copy to .env and fill in. .env is git-ignored.
#
# Local: `npm run db:dev` starts Prisma's local Postgres and prints its connection string.
# Production (Vercel + Neon): use Neon's connection strings, as described below.

# Used by the running app. On Neon, use the *pooled* connection string (host contains "-pooler").
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Used by Prisma migrations and the ingestion script. On Neon, use the *direct* connection string.
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Integration tests only (`npm run db:dev:test`, then `npm run test:integration`).
# Never point this at a database you care about.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Max pooled connections per server process (default 5). Use 1 with the local Prisma dev database.
DATABASE_POOL_MAX=1
# Cap build workers (each opens a DB pool). Use 1 with the local Prisma dev database; unset on Vercel.
NEXT_BUILD_CPUS=1
